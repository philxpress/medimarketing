# ─────────────────────────────────────────────────────────────
# MediReach environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firebase (client SDK) ──
# From Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server only) ──
# From Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the private key with literal \n newlines, wrapped in quotes.
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ── Google OAuth (for connecting a Gmail mailbox to SEND from) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Enable the Gmail API. Add redirect URI: {APP_URL}/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Microsoft OAuth (for connecting an M365 mailbox to SEND from) ──
# Azure Portal → App registrations. Delegated Graph scopes: Mail.Send offline_access User.Read
# Redirect URI: {APP_URL}/api/integrations/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# ── AI providers ──
# Text generation (Anthropic Claude). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Image generation (OpenAI images). Optional — leave blank to disable image gen.
OPENAI_API_KEY=

# ── Encryption key for stored OAuth refresh tokens (32-byte base64) ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
